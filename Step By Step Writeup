7) Reconstruct private key (PEM)
#Use Python + cryptography to compute d and build the PEM private key:

python3 - <<PY
from cryptography.hazmat.backends import default_backend
from cryptography.hazmat.primitives.asymmetric import rsa
from cryptography.hazmat.primitives import serialization
from math import gcd
import gmpy2

P = int(open("pq.txt").read().splitlines()[0])
Q = int(open("pq.txt").read().splitlines()[1])
N = int(open("n.txt").read().strip())
e = 65537

l = (P-1)//gcd(P-1, Q-1) * (Q-1)
d = pow(e, -1, l) if hasattr(pow, "__call__") else int(gmpy2.invert(e, l))

dmp1 = d % (P-1); dmq1 = d % (Q-1)
iqmp = int(gmpy2.invert(Q, P))

priv = rsa.RSAPrivateNumbers(
    p=P, q=Q, d=d, dmp1=dmp1, dmq1=dmq1, iqmp=iqmp,
    public_numbers=rsa.RSAPublicNumbers(e=e, n=N)
).private_key(default_backend())

pem = priv.private_bytes(
    encoding=serialization.Encoding.PEM,
    format=serialization.PrivateFormat.PKCS8,
    encryption_algorithm=serialization.NoEncryption()
)

open("ssh_private_key.pem","wb").write(pem)
print("WROTE ssh_private_key.pem")
PY
chmod 600 ssh_private_key.pem

