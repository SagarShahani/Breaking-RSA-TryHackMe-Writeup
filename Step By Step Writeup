5) Factor n with Fermat (p and q are close)
#Fermat method is efficient when p and q are near each other.

#Save this small helper as fermat_factor.py and run it:

#!/usr/bin/env python3
try:
    from gmpy2 import isqrt
except Exception:
    from math import isqrt

def factorize(n):
    n = int(n)
    if (n & 1) == 0:
        return n//2, 2
    a = isqrt(n)
    if a*a == n:
        return int(a), int(a)
    while True:
        a += 1
        bsq = a*a - n
        b = isqrt(bsq)
        if b*b == bsq:
            return int(a+b), int(a-b)

if __name__ == "__main__":
    n = int(open("n.txt").read().strip())
    p, q = factorize(n)
    print(p)
    print(q)
